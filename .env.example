# ---------------------------------------------------------------------------
# DemandForge AI - environment template. Copy to .env.local and fill in.
# Never commit real credentials. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Public application origin (used for auth redirects and origin checks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Current publishable key ("sb_publishable_..."). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy anon JWT key, only if your project has not migrated to publishable keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS - never expose to the client or extension.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini (server-only). https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional pricing used for usage estimates (USD per 1M tokens).
GEMINI_INPUT_PRICE_PER_MILLION=0.30
GEMINI_OUTPUT_PRICE_PER_MILLION=2.50

# Vercel deployment integration (server-only).
# Create a token at https://vercel.com/account/tokens with access to one team.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Dedicated Vercel project used exclusively for generated demo deployments.
VERCEL_PROJECT_ID=
# Dedicated demo project name, used only when VERCEL_PROJECT_ID is not set.
VERCEL_PROJECT_NAME=demandforge-demos

# Shared secret for the queue worker endpoint. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>" when configured in project settings.
CRON_SECRET=

# Server-only one-time setup secret. Generate a random value before deployment;
# never commit it or expose it to the browser.
OWNER_SETUP_SECRET=

# Optional direct Postgres connection string, only used by `pnpm test:rls`.
# Example: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

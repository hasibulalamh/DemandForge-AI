{
  "manifest_version": 3,
  "name": "DemandForge AI Importer",
  "version": "1.0.0",
  "description": "Import project requests you are authorised to view into DemandForge AI. No automatic collection.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "DemandForge AI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
